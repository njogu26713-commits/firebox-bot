# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# 💎 FIREBOX BOT MASTER CONFIGURATION
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# 🔑 1. SESSION (REQUIRED)
# --------------------------------------
# SESSION_ID: Your unique bot session (starts with FIREBOX~).
# Get this by scanning the QR code once or running .session in WhatsApp.
SESSION_ID=

# SESSION_SECRET: Keep a fixed, long random value in production so signed-in
# Firebox Control dashboard sessions remain valid across restarts.
SESSION_SECRET=

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ⚙️  2. OPTIONAL SETTINGS
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# SUDO: Super-Admin number with country code. Can run owner commands.
SUDO=

# OWNERS: Additional admin numbers, separated by commas.
OWNERS=

# PAIRING_NUMBER: Connect without QR code (optional).
PAIRING_NUMBER=

# PREFIX: Command prefix (default is .)
PREFIX=.

# MODE: 'public' or 'private' (default is public)
MODE=public

# Railway: add a MongoDB service, then reference its private MONGO_URL here.
# For a separate project, use MONGO_PUBLIC_URL or set MONGODB_URI directly.
MONGO_URL=
MONGO_PUBLIC_URL=
MONGODB_URI=

# AI keys (optional — only needed for .ai / .imagine commands)
GROQ_API_KEY=
OPENAI_API_KEY=

# M-Pesa STK Push (disabled until real Daraja credentials are configured)
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=false
MPESA_CONSUMER_SECRET=false
MPESA_SHORTCODE=false
MPESA_PASSKEY=false
MPESA_CALLBACK_URL=false

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# ℹ️  Rename this file to ".env" before running the bot.
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
# 🌐 3. CENTRAL FIREBOX WEBHOOK HUB (OPTIONAL)
# --------------------------------------
# When all three are set, this deployment registers itself in the hub dashboard.
FIREBOX_HUB_URL=
FIREBOX_BOT_ID=
FIREBOX_BOT_KEY=
# Public URL users open to pair with this specific bot deployment.
FIREBOX_PUBLIC_URL=
# Display name shown in the hub server list.
FIREBOX_BOT_NAME=

# Panel server registry security. Keep both values private and stable across restarts.
FIREBOX_PANEL_ADMIN_TOKEN=
FIREBOX_REGISTRY_SECRET=
# Only this signed-in email can open /admin and manage bot servers.
FIREBOX_ADMIN_EMAIL=
